# Copiá este archivo como .env y completalo.

# Clave de OpenAI (es el único servicio externo que usa la app)
OPENAI_API_KEY=sk-...

# Carpetas fijas de música y videos, separadas por | (barra vertical).
# Adentro, cada carpeta que contiene archivos es un disco/colección.
# Si alguna no existe al abrir (p. ej. un disco externo desconectado), se saltea con un aviso.
# Mac:     MUSICA_CARPETAS=/Users/tu_usuario/Music | /Volumes/Disco externo/Series
# Windows: MUSICA_CARPETAS=C:\Users\tu_usuario\Music | D:\Series
MUSICA_CARPETAS=

# Modelo y esfuerzo de razonamiento (none, low, medium, high)
OPENAI_MODELO=gpt-6-luna
OPENAI_ESFUERZO=low

# Mostrar la imagen cuando el archivo es un video (si/no)
MOSTRAR_VIDEO=si

# Opcional: ruta a mpv si no está en el PATH
# MPV_RUTA=

# Para que las búsquedas web den resultados locales
# (opcional; vacío = sin ubicación y con la zona horaria de la compu)
# Ej.: UBICACION_PAIS=ES / UBICACION_CIUDAD=Madrid / ZONA_HORARIA=Europe/Madrid
UBICACION_PAIS=
UBICACION_CIUDAD=
ZONA_HORARIA=

# ---------- Voz ----------
# Frase de activación y exigencia (0-100; más alto = más estricto, menos activaciones por error)
FRASE_ACTIVACION=hola asistente
UMBRAL_ACTIVACION=85

# Modelos de Whisper (locales): uno rápido para escuchar y uno preciso para confirmar y entender
# Opciones de menor a mayor precisión: tiny, base, small, medium, large-v3-turbo
WHISPER_MODELO_ACTIVACION=base
WHISPER_MODELO=small

# Voz de Piper y velocidad (1.0 normal, 1.2 más rápido)
PIPER_VOZ=es_AR-daniela-high
VELOCIDAD_VOZ=1.0

# Micrófono que aparece marcado por defecto al iniciar (número o parte del nombre). Vacío = el del sistema.
MICROFONO=
