# Copiá este archivo como .env y completalo.

# Clave de OpenAI (cerebro, búsqueda web, reconocimiento de voz y voz de las respuestas)
OPENAI_API_KEY=sk-...

# Carpetas fijas de música y videos, separadas por | (barra vertical).
# Adentro, cada carpeta que contiene archivos es un disco/colección.
# Si alguna no existe al abrir (p. ej. un disco externo desconectado), se saltea con un aviso.
# Ej.: MUSICA_CARPETAS=/Users/tu_usuario/Music | /Volumes/Disco externo/Series
MUSICA_CARPETAS=

# Opcional: Mac que comparte por red las carpetas de /Volumes de MUSICA_CARPETAS.
# Si está puesto, ./iniciar.sh las conecta solo antes de abrir la app (como invitado).
# Ej.: SERVIDOR_MUSICA=Mi-Mac.local
SERVIDOR_MUSICA=

# Modelo y esfuerzo de razonamiento (none, low, medium, high)
OPENAI_MODELO=gpt-6-luna
OPENAI_ESFUERZO=low

# Mostrar la imagen cuando el archivo es un video (si/no)
MOSTRAR_VIDEO=si

# Opcional: ruta a mpv si no está en el PATH
# MPV_RUTA=

# Para que las búsquedas web den resultados locales
# (opcional; vacío = sin ubicación y con la zona horaria de la compu)
# Ej.: UBICACION_PAIS=ES / UBICACION_CIUDAD=Madrid / ZONA_HORARIA=Europe/Madrid
UBICACION_PAIS=
UBICACION_CIUDAD=
ZONA_HORARIA=

# ---------- Voz ----------
# "Hola asistente" se detecta EN ESTE EQUIPO (Vosk), sin internet y gratis. Solo cuando Vosk
# cree escucharla, ese fragmento se confirma con OpenAI (que también transcribe el pedido).
# Frase en palabras que conoce el modelo de Vosk, y confianza mínima (0-100;
# más alto = más estricto, menos activaciones por error).
FRASE_ACTIVACION_LOCAL=hola asistente
UMBRAL_ACTIVACION=85

# Exigencia del detector de voz (0-3). Más alto = ignora más ruido.
VAD_AGRESIVIDAD=2
# Fragmentos de voz más cortos que esto (segundos) se ignoran
DURACION_MINIMA_VOZ=0.6

# Reconocimiento del pedido (OpenAI, solo después de "Hola asistente")
STT_MODELO=gpt-4o-mini-transcribe

# Voz de las respuestas (OpenAI TTS) y velocidad (1.0 normal, 1.2 más rápido)
TTS_MODELO=gpt-4o-mini-tts
TTS_VOZ=coral
TTS_INSTRUCCIONES=Hablá en español rioplatense, con tono cálido y natural.
VELOCIDAD_VOZ=1.0

# Micrófono que aparece marcado por defecto al iniciar (número o parte del nombre). Vacío = el del sistema.
MICROFONO=
